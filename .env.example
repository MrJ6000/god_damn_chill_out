# ============================================
# PolicyVault Sentinel — 環境變數範本
# 複製成 .env 後填入你自己的值
# 🔴 .env 絕對不要 commit 到 git
# ============================================

# ---- OpenAI（M1 必填，其他人可留空）----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- 伺服器 ----
API_PORT=3001
NEXT_PUBLIC_API_BASE=http://localhost:3001

# ---- 假資料模式（模組還沒好時用）----
MOCK_AGENT=0
MOCK_CHAIN=0

# ---- 區塊鏈（M3 必填）----
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
RPC_URL_BACKUP=
ZERODEV_PROJECT_ID=
BUNDLER_RPC=
PAYMASTER_RPC=

# ---- 金鑰（🔴 絕對不能 commit）----
DEPLOYER_PRIVATE_KEY=
CFO_ROOT_PRIVATE_KEY=
AI_SESSION_PRIVATE_KEY=

# ---- 合約位址（M3 部署後填入並在群組公告）----
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SMART_ACCOUNT_ADDRESS=
TREASURY_POLICY_MODULE=

# ---- 政策參數（M2 維護）----
POLICY_VERSION=V18
MAX_PER_TX_USD=5000
MAX_PER_24H_USD=10000
SESSION_EXPIRES_AT=2026-09-07T23:59:00Z
TREASURY_BALANCE_USD=2000000
